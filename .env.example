# SignalDesk local environment
# Copy this file to `.env.local` before running the app.

# Market-data driver: "yahoo" (default, no key required) or "rest"
MARKET_DATA_PROVIDER=yahoo

# Required only when MARKET_DATA_PROVIDER=rest
# The REST provider calls:
#   GET {MARKET_DATA_BASE_URL}/quote/{NSE_SYMBOL}
#   GET {MARKET_DATA_BASE_URL}/history/{NSE_SYMBOL}
#   GET {MARKET_DATA_BASE_URL}/search?q=
#   GET {MARKET_DATA_BASE_URL}/fundamentals/{NSE_SYMBOL}
# and sends Authorization: Bearer {MARKET_DATA_API_KEY} when the key is set.
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=

# Optional SQLite cache path. Defaults to ./data/cache.sqlite
# MARKET_DATA_CACHE_PATH=

# Optional technical score weights. They are normalized if they do not sum to 1.
# TECH_WEIGHT_TREND=0.35
# TECH_WEIGHT_MOMENTUM=0.20
# TECH_WEIGHT_VOLUME=0.15
# TECH_WEIGHT_BREAKOUT=0.15
# TECH_WEIGHT_STRUCTURE=0.15
